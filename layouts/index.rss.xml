{{- /* Keep home-scoped index.rss.xml so Hugo 0.146+/0.160.1 does not let layouts/index.rsshighscore.xml shadow layouts/_default/rss.xml for /index.xml. */ -}}
{{- $dailyPages := slice }}
{{- range where site.RegularPages "Section" "posts" }}
  {{- $metadata := partial "research_metadata.html" . }}
  {{- if eq $metadata.pageType "daily" }}
    {{- $dailyPages = $dailyPages | append . }}
  {{- end }}
{{- end }}
{{- $pages := first 50 (sort $dailyPages "Date" "desc") }}
{{- printf "<?xml version=\"1.0\" encoding=\"utf-8\" standalone=\"yes\"?\u003e" | safeHTML }}
<rss version="2.0" xmlns:atom="http://www.w3.org/2005/Atom">
  <channel>
    <title>{{ site.Title }}</title>
    <link>{{ site.Home.Permalink }}</link>
    <description>{{ site.Params.description | default site.Title }}</description>
    <language>{{ site.Language.LanguageCode }}</language>
    {{- with site.Home.OutputFormats.Get "RSS" }}
    <atom:link href="{{ .Permalink }}" rel="self" type="{{ .MediaType.Type }}" />
    {{- end }}
    {{- if gt (len $pages) 0 }}
    <lastBuildDate>{{ (index $pages 0).Date.Format "Mon, 02 Jan 2006 15:04:05 -0700" }}</lastBuildDate>
    {{- end }}
    {{- range $pages }}
    {{- $parts := slice }}
    {{- $desc := strings.TrimSpace (partial "plain_summary.html" (.Description | default "")) }}
    {{- if $desc }}{{ $parts = $parts | append $desc }}{{ end }}
    {{- $raw := .RawContent | default "" }}
    {{- range findRE `(?m)^-[ \t]+\*\*(?:焦点方向|阅读与开源快照)\*\*[：:][^\n]+` $raw 2 }}
      {{- $line := replaceRE `^-[ \t]+` "" . }}
      {{- $line = replaceRE `\[([^\]]+)\]\([^)]+\)` "$1" $line }}
      {{- $line = replace $line "**" "" }}
      {{- $line = strings.TrimSpace (partial "plain_summary.html" $line) }}
      {{- if $line }}{{ $parts = $parts | append $line }}{{ end }}
    {{- end }}
    {{- with .Params.tags }}
      {{- $topTags := first 6 . }}
      {{- if gt (len $topTags) 0 }}
        {{- $suffix := cond (gt (len .) 6) "等" "" }}
        {{- $parts = $parts | append (printf "涵盖方向：%s%s" (delimit $topTags "、") $suffix) }}
      {{- end }}
    {{- end }}
    {{- $summary := "" }}
    {{- if gt (len $parts) 0 }}
      {{- $summary = delimit $parts " · " | truncate 460 }}
    {{- else }}
      {{- $summary = printf "%s 每日语音、音乐与声学 AI 论文深度导读与完整目录。" (.Date.Format "2006-01-02") }}
    {{- end }}
    <item>
      <title>{{ .Title }}</title>
      <link>{{ .Permalink }}</link>
      <guid isPermaLink="true">{{ .Permalink }}</guid>
      <pubDate>{{ .Date.Format "Mon, 02 Jan 2006 15:04:05 -0700" }}</pubDate>
      <description>{{ $summary }}</description>
      {{- range .GetTerms "tags" }}
      <category>{{ .LinkTitle }}</category>
      {{- end }}
    </item>
    {{- end }}
  </channel>
</rss>
